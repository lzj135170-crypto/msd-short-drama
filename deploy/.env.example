# 复制为 deploy/.env 后填写真实值；.env 不提交仓库
# 本文件只作为模板，下面的值仅用于本地开发

# 虚拟机 192.168.33.129 上的 Redis / Kafka
REDIS_HOST=192.168.33.129
REDIS_PORT=6379
# 真实密码放 deploy/.env（已 gitignore），不要提交
REDIS_PASSWORD=change-me
KAFKA_BOOTSTRAP_SERVERS=192.168.33.129:9092

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# Nacos 3.x 服务端鉴权，本地关闭；但 3.x 启动脚本强制要求 token，必须给 Base64 字符串
NACOS_AUTH_ENABLE=false
# 仅本地开发；生产环境必须替换（openssl rand -base64 32）
NACOS_AUTH_TOKEN=9l+KWxfkR63c8y/LVWF4KVJArqqtbT7NEGBL/qSZ4Zg=
NACOS_AUTH_IDENTITY_KEY=change-me
NACOS_AUTH_IDENTITY_VALUE=change-me

# Nacos 控制台/管理 API（初始化脚本使用）
NACOS_CONSOLE_URL=http://127.0.0.1:8080
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me

# Sentinel Dashboard 地址；client-ip 用 dashboard 容器能回连的宿主机 IPv4
# Docker Desktop 通常是 192.168.65.1；不能用 host.docker.internal（dashboard 会做 IP 校验）
SENTINEL_DASHBOARD=127.0.0.1:8858
SENTINEL_CLIENT_IP=192.168.65.1

MSD_DB_URL=jdbc:mysql://127.0.0.1:3306/DL?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MSD_DB_USERNAME=msd
MSD_DB_PASSWORD=change-me

# Seata Server 注册到 Nacos 的地址，必须是宿主机可达的非回环 IP
# Docker Desktop 通常是 192.168.65.1；其他机器改成宿主机局域网 IP
SEATA_IP=192.168.65.1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 分集摘要/会话压缩使用的轻量模型，可覆盖 content-config.yaml 默认值
COMPANION_LIGHT_MODEL=qwen-flash

# RexUniNLU 本地 sidecar（可选，未启动时审核自动降级情感建议）
REX_UNINLU_MODEL_DIR=
REX_UNINLU_PORT=8108
REX_UNINLU_INTERNAL_TOKEN=

XXL_JOB_ACCESS_TOKEN=change-me
